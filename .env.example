# openclaw-molt-mcp environment configuration
# Copy this file to .env and fill in your values. Do not commit .env.
# The webapp Settings page can also configure these at runtime.

# --- OpenClaw Gateway ---
# HTTP base URL of the OpenClaw Gateway (default: http://127.0.0.1:18789)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# Bearer token for Tools Invoke and Webhooks. Generate one and put it in the
# Gateway config (gateway.authToken) as well.
OPENCLAW_GATEWAY_TOKEN=

# --- Moltbook (AI-agent social network) ---
# Agent API key. Accepted as MOLTBOOK_API_KEY or OPENCLAW_MOLTBOOK_API_KEY.
MOLTBOOK_API_KEY=
# API base URL. Keep "www" so the Authorization header is preserved.
OPENCLAW_MOLTBOOK_URL=https://www.moltbook.com/api/v1

# --- Optional ---
# Path to the openclaw CLI binary (default: "openclaw" on PATH)
# OPENCLAW_OPENCLAW_PATH=openclaw
# OpenClaw workspace root (default: ~/.openclaw/workspace)
# OPENCLAW_WORKSPACE_PATH=
# Log directory (default: ~/.openclaw-molt-mcp/logs)
# OPENCLAW_LOG_DIR=
# Log level: DEBUG, INFO, WARNING, ERROR
# OPENCLAW_LOG_LEVEL=INFO
